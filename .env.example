# FinCas — stack Docker
# Copie para .env e preencha. NUNCA commite o .env preenchido.
# No Portainer, prefira definir estes valores nas variáveis da Stack.

# ── OBRIGATÓRIA ────────────────────────────────────────────────
# Senha do PostgreSQL. Sem valor, o container do banco RECUSA INICIAR.
# Só tem efeito na criação do volume: num banco que já existe, trocar
# aqui não muda nada — é preciso um ALTER USER dentro do Postgres.
DB_PASSWORD=

# ── OPCIONAIS (têm padrão) ─────────────────────────────────────
DB_USER=financas_user
DB_NAME=financas_db
BACKEND_PORT=3001
FRONTEND_PORT=8082

# Domínio para o roteamento pelo Traefik.
APP_HOST=fincas.nexis.dev.br

# ── OPCIONAIS — integração Evolution API (WhatsApp) ────────────
# Sem elas, o app funciona; só o envio de mensagens fica indisponível.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
