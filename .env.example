# FinCas — stack Docker
# Copie para .env e preencha. NUNCA commite o .env preenchido.
# No Portainer, prefira definir estes valores nas variáveis da Stack.

# --- Banco de dados ---
DB_USER=financas_user
DB_PASSWORD=
DB_NAME=financas_db

# --- Portas publicadas no host ---
BACKEND_PORT=3001
FRONTEND_PORT=80

# --- Domínio (roteamento pelo Traefik) ---
APP_HOST=fincas.seudominio.com.br

# --- Integração Evolution API (WhatsApp) ---
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
